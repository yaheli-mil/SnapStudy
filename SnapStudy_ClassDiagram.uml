@startuml SnapStudy_ClassDiagram
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam shadowing false
skinparam packageStyle rectangle
set separator none
hide empty members

package "Android / Java" {
    class AppCompatActivity
    class View
    class Application
    class "RecyclerView.Adapter" as RecyclerViewAdapter
    interface Serializable
}

package "com.yalig.snapstudy.models" {
    class Flashcard {
        - id: String
        - question: String
        - answer: String
        - topic: String
        - intervalDays: int
        - repetitionCount: int
        - difficulty: int
        + incrementRepetition(): void
        + applyRating(difficulty: int): void
    }

    class StudySet {
        - id: String
        - title: String
        - category: String
        - updatedInfo: String
        - masteryPercentage: int
        - flashcards: List<Flashcard>
        + getCardCount(): int
        + addFlashcard(card: Flashcard): void
        + updateMasteryPercentage(): void
    }
}

package "com.yalig.snapstudy.data" {
    interface SetsCallback {
        + onSetsLoaded(sets: ArrayList<StudySet>): void
    }

    class StudyRepository {
        + {static} loadSets(callback: SetsCallback): void
        + {static} saveSet(set: StudySet): void
        - {static} getSetsCollection(): CollectionReference
    }

    class StatsManager {
        - {static} PREFS_NAME: String
        + {static} recordCardStudied(ctx: Context): void
        + {static} getCardsToday(ctx: Context): int
        + {static} getStreakDays(ctx: Context): int
        + {static} getDailyGoal(ctx: Context): int
        + {static} setDailyGoal(ctx: Context, goal: int): void
        + {static} getFocusMinutes(ctx: Context): int
        + {static} addFocusSeconds(ctx: Context, seconds: int): void
    }
}

package "com.yalig.snapstudy.ai" {
    class GeminiConfig {
        + {static} API_KEY: String
        + {static} MODEL: String
    }

    interface AiStudyCallback {
        + onSuccess(studySet: StudySet): void
        + onError(message: String): void
    }

    class GeminiStudyService {
        - {static} PROMPT: String
        + {static} generateFlashcards(activity: Activity, bitmap: Bitmap, callback: AiStudyCallback): void
        - {static} buildRequest(imageBase64: String): JSONObject
        - {static} sendPost(url: String, body: String): String
        - {static} parseResponse(response: String): StudySet
        - {static} scaleBitmap(bitmap: Bitmap, maxSize: int): Bitmap
        - {static} bitmapToBase64(bitmap: Bitmap): String
    }
}

package "com.yalig.snapstudy.ui" {
    class DocumentOverlayView {
        - photo: Bitmap
        - textBounds: Rect
        - framePaint: Paint
        + setPhoto(photo: Bitmap): void
        + setTextBounds(textBounds: Rect): void
        # onDraw(canvas: Canvas): void
    }

    interface OnSetClickListener {
        + onSetClick(set: StudySet): void
    }

    class StudySetAdapter {
        - sets: ArrayList<StudySet>
        - listener: OnSetClickListener
        + setSets(sets: ArrayList<StudySet>): void
        + onCreateViewHolder(parent: ViewGroup, viewType: int): SetViewHolder
        + onBindViewHolder(holder: SetViewHolder, position: int): void
        + getItemCount(): int
    }
}

package "com.yalig.snapstudy" {
    class SnapStudyApp {
        - {static} PREFS_NAME: String
        + {static} getThemeMode(ctx: Context): int
        + {static} setThemeMode(ctx: Context, mode: int): void
        + {static} isReminderEnabled(ctx: Context): boolean
        + {static} getReminderTime(ctx: Context): String
        + {static} isSoundEnabled(ctx: Context): boolean
    }

    class LoginActivity {
        - auth: FirebaseAuth
        - isSignUpMode: boolean
        - setSignUpMode(signUp: boolean): void
        - signIn(): void
        - signUp(): void
        - showForgotPasswordDialog(): void
        - signInWithGoogle(): void
        - goToMain(): void
    }

    class MainActivity {
        - allSets: ArrayList<StudySet>
        - adapter: StudySetAdapter
        - etSearch: EditText
        # onResume(): void
        - showStats(): void
        - showSets(): void
        - showCreateSetDialog(): void
    }

    class ScannerActivity {
        - overlayView: DocumentOverlayView
        - photo: Bitmap
        - cameraPhotoUri: Uri
        - openCamera(): void
        - loadPhoto(uri: Uri): void
        - findText(bitmap: Bitmap): void
        - createCards(): void
    }

    class FlashcardsActivity {
        - studySet: StudySet
        - currentIndex: int
        - correctCount: int
        - startTime: long
        - showCard(): void
        - revealAnswer(): void
        - rateCard(difficulty: int): void
        - showFinishDialog(): void
    }

    class SettingsActivity {
        - changeTheme(mode: int): void
        - showDailyGoalDialog(): void
        - showTimePicker(): void
    }
}

' Inheritance and interface realization
AppCompatActivity <|-- LoginActivity
AppCompatActivity <|-- MainActivity
AppCompatActivity <|-- ScannerActivity
AppCompatActivity <|-- FlashcardsActivity
AppCompatActivity <|-- SettingsActivity
View <|-- DocumentOverlayView
RecyclerViewAdapter <|-- StudySetAdapter
Application <|-- SnapStudyApp
Serializable <|.. Flashcard
Serializable <|.. StudySet

' Composition and aggregation
StudySet "1" *-- "0..*" Flashcard : contains
StudySetAdapter "1" o-- "0..*" StudySet : shows
ScannerActivity "1" *-- "1" DocumentOverlayView : shows photo and frame
MainActivity "1" *-- "1" StudySetAdapter : list of sets

' Dependencies
StudyRepository ..> StudySet : loads and saves
StudyRepository ..> SetsCallback : returns sets
GeminiStudyService ..> GeminiConfig : reads API key
GeminiStudyService ..> StudySet : creates
GeminiStudyService ..> AiStudyCallback : returns result
ScannerActivity ..> GeminiStudyService : sends photo
ScannerActivity ..> AiStudyCallback : anonymous class
ScannerActivity ..> StudyRepository : saves set
MainActivity ..> StudyRepository : loads sets
FlashcardsActivity ..> StudyRepository : saves progress
FlashcardsActivity ..> StatsManager : updates stats
SettingsActivity ..> StatsManager : daily goal
StudySetAdapter ..> OnSetClickListener : click on set
LoginActivity ..> MainActivity : opens
MainActivity ..> ScannerActivity : opens
MainActivity ..> FlashcardsActivity : opens
MainActivity ..> SettingsActivity : opens
ScannerActivity ..> FlashcardsActivity : opens
@enduml
